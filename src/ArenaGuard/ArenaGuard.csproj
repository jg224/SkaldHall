<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SkaldHall</AssemblyName>
    <RootNamespace>ArenaGuard</RootNamespace>
    <Nullable>disable</Nullable>
    <Version>0.0.4</Version>
    <AssemblyVersion>0.0.4.0</AssemblyVersion>
    <FileVersion>0.0.4.0</FileVersion>
    <InformationalVersion>0.0.4</InformationalVersion>
    <Company>jg224</Company>
    <Authors>jg224</Authors>
    <Product>SkaldHall</Product>
    <Description>Server-authoritative NPC activities and challenge arenas for Valheim.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ValheimRoot Condition="'$(ValheimRoot)' == ''">C:\ValheimServer\server</ValheimRoot>
    <ValheimManaged>$(ValheimRoot)\valheim_server_Data\Managed</ValheimManaged>
    <BepInExCore>$(ValheimRoot)\BepInEx\core</BepInExCore>
    <JotunnPath>$(ValheimRoot)\BepInEx\plugins\Jotunn.dll</JotunnPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ValheimManaged)\assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ValheimManaged)\assembly_guiutils.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManaged)\assembly_utils.dll" Private="false" />
    <Reference Include="Splatform" HintPath="$(ValheimManaged)\Splatform.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ValheimManaged)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(ValheimManaged)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ValheimManaged)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ValheimManaged)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ValheimManaged)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ValheimManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ValheimManaged)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Jotunn" HintPath="$(JotunnPath)" Private="false" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <Target Name="CheckValheimReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExCore)\BepInEx.dll')" Text="BepInEx.dll was not found under ValheimRoot '$(ValheimRoot)'." />
    <Error Condition="!Exists('$(ValheimManaged)\assembly_valheim.dll')" Text="assembly_valheim.dll was not found under ValheimRoot '$(ValheimRoot)'." />
    <Error Condition="!Exists('$(JotunnPath)')" Text="Jotunn.dll was not found under ValheimRoot '$(ValheimRoot)'." />
  </Target>
</Project>
